# Local development values. Copy to .env for the local stack: every process reads the .env at
# the repo root. Do not use this file as a production template. The secrets below are public,
# and docs/self-hosting/README.md lists what production needs.

NODE_ENV=development

APP_URL=http://localhost:5173
# Read by scripts/smoke.ts and scripts/load.ts. The CLI and the SDKs use DISPATCH_API_URL or DISPATCH_BASE_URL.
API_URL=http://localhost:3100
DATABASE_URL=postgres://dispatch:dispatch@localhost:5432/dispatch
REDIS_URL=redis://localhost:6379
RATE_LIMIT_PER_SECOND=10
# Requests per second for one signed-in dashboard user. Counted apart from the API key limit.
SESSION_RATE_LIMIT_PER_SECOND=40
WORKER_CONCURRENCY=5
# Behind a load balancer: a hop count such as 1, or a list of proxy addresses.
# TRUST_PROXY=1

APP_SECRET=dev-secret-change-before-deploy
API_KEY_PEPPER=dev-pepper-change-before-deploy
# The key pnpm db:seed gives the local tenant.
DISPATCH_API_KEY=sk_local_dispatch_dev_key_change_before_deploy
# The dashboard password pnpm db:seed gives operator@example.test.
DISPATCH_PASSWORD=dispatch-local-password
SES_PROVIDER=fake
AWS_REGION=us-west-2

STORAGE_BACKEND=local
STORAGE_DIR=.dispatch/storage
# With STORAGE_BACKEND=s3:
# S3_BUCKET=dispatch-local
# An S3-compatible store such as MinIO. Leave unset for AWS.
# S3_ENDPOINT=http://localhost:9000
# Where the seeded sample webhook posts.
WEBHOOK_URL=http://localhost:8787/webhooks

# One port or several, separated by commas. Ports below 1024 need root on Linux.
SMTP_PORT=2587
SMTP_TLS_PORT=2465
SMTP_MAX_CLIENTS=50
# The relay's public hostname, shown on the dashboard's SMTP settings page.
# SMTP_HOST=smtp.mail.example.com
# SMTP_TLS_CERT=/path/to/fullchain.pem
# SMTP_TLS_KEY=/path/to/privkey.pem

TRACKING_DOMAIN=links.localhost
# Set to true only when https://<tracking_subdomain>.<domain> has a certificate for every verified domain.
TRACKING_CUSTOM_HOSTS=false
# The region the SES receipt rule runs in. Defaults to AWS_REGION.
# SES_INBOUND_REGION=us-west-2
