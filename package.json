{
  "name": "dispatch",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "scripts": {
    "build": "pnpm -r build",
    "check": "pnpm -r check",
    "dev": "pnpm --parallel --filter @dispatch/api --filter @dispatch/worker --filter @dispatch/dashboard dev",
    "dev:api": "pnpm --filter @dispatch/api dev",
    "dev:worker": "pnpm --filter @dispatch/worker dev",
    "dev:dashboard": "pnpm --filter @dispatch/dashboard dev",
    "db:migrate": "pnpm --filter @dispatch/db migrate",
    "db:seed": "pnpm --filter @dispatch/db seed",
    "doctor": "pnpm --filter @dispatch/cli start -- doctor",
    "format": "prettier --write .",
    "lint": "pnpm -r lint",
    "load": "tsx scripts/load.ts",
    "smoke": "tsx scripts/smoke.ts",
    "test": "vitest run",
    "typecheck": "pnpm -r typecheck"
  },
  "devDependencies": {
    "@types/node": "^22.15.29",
    "dotenv": "^16.5.0",
    "prettier": "^3.5.3",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3",
    "vitest": "^3.1.4"
  }
}
